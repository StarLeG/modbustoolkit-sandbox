# Modbus Test Server — переменные окружения (см. CLAUDE.md, раздел «Env»).
# Скопируйте в .env и поправьте под окружение. Секреты в код не включать.

# Адрес слушателя Modbus-TCP
MODBUS_TCP_HOST=0.0.0.0

# TCP-порт Modbus (502 — опционально, если окружение позволяет)
MODBUS_TCP_PORT=5020

# Публичный адрес сервера для клиентов: показывается на «Обзоре» и
# подставляется в генератор конфигов (своя инсталляция - свой домен/IP)
MODBUS_PUBLIC_HOST=modbus-sendbox.electroman.by

# Адрес web-слушателя (uvicorn), только для `python -m app`
WEB_HOST=127.0.0.1

# TCP-порт web UI/REST/WS, только для `python -m app`
WEB_PORT=8765

# Адреса обратного прокси, которым uvicorn доверяет в X-Forwarded-For
# (через запятую; "*" - доверять всем, только если app недоступен извне)
FORWARDED_ALLOW_IPS=127.0.0.1

# Формат логов: text (разработка) или json (одна строка JSON на событие,
# удобно для journald/docker logs и shipper'ов)
LOG_FORMAT=text

# Уровень логов: debug, info, warning, error
LOG_LEVEL=info

# Лимит соединений с одного IP
MODBUS_MAX_CONN_PER_IP=20

# Лимит Modbus-записей на соединение, шт/с
MODBUS_MAX_WRITE_PER_SEC=200

# Лимит действий из Web UI на IP (записи, поведения, снимки, инъекции), шт/мин
WEB_MAX_WRITE_PER_MIN_PER_IP=50

# Период тика движка поведений, мс
ENGINE_TICK_MS=100

# Частота WS-обновлений состояния, Гц
WS_STATE_HZ=2

# Размер ring buffer журнала событий, записей
JOURNAL_SIZE=1000

# Максимальное время жизни инъекции ошибки, с
INJECTION_MAX_TTL_S=300
